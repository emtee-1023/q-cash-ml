{
  "policy_version": "era-policy-v1",
  "provisional": true,
  "description": "Provisional Q-Cash ERA assessment and repayment policy. All weights, rates, thresholds and limits are clearly labelled defaults pending empirical validation against actual repayment outcomes. They must not be treated as a production lending policy.",
  "currency": "KES",
  "forecast_period_days": 30,
  "minimum_history_days": 90,
  "minimum_transactions": 30,
  "max_unknown_ratio": 0.5,
  "max_anomaly_ratio": 0.1,
  "classification": {
    "sale_keywords": ["payment", "till", "paybill", "sale", "invoice", "receipt", "buygoods"],
    "refund_keywords": ["refund"],
    "reversal_keywords": ["reversal", "reversed", "chargeback", "reversed_transaction"],
    "capital_keywords": ["capital", "injection", "owner_contribution", "contribution", "shareholder"],
    "transfer_keywords": ["transfer", "internal", "disbursement", "bank"],
    "failed_statuses": ["reversed", "failed", "declined", "cancelled", "void"],
    "pending_statuses": ["pending", "processing", "held"],
    "assume_unknown_as_sale": false,
    "anomaly": {
      "mad_multiplier": 5.0,
      "min_tx_for_anomaly": 10
    }
  },
  "scoring": {
    "weights": {
      "revenue_consistency": 0.20,
      "revenue_volatility": 0.20,
      "transaction_frequency": 0.15,
      "active_days": 0.10,
      "revenue_trend": 0.15,
      "transaction_concentration": 0.10,
      "repayment_history": 0.10
    },
    "volatility_cv_ceiling": 1.0,
    "frequency_ref_per_active_day": 20.0,
    "trend_ref": 0.5,
    "min_eligible_score": 40,
    "score_bands": [
      { "min": 70, "label": "high" },
      { "min": 50, "label": "medium" },
      { "min": 30, "label": "low" },
      { "min": 0, "label": "very_low" }
    ]
  },
  "advance": {
    "rate_bands": [
      { "min_score": 70, "advance_rate": 0.35 },
      { "min_score": 50, "advance_rate": 0.30 },
      { "min_score": 30, "advance_rate": 0.20 }
    ],
    "min_advance_kes": 1000.0,
    "max_advance_kes": 100000.0,
    "max_exposure_kes": 100000.0,
    "cold_start": {
      "enabled": true,
      "conservative_advance_kes": 5000.0,
      "conservative_advance_rate": 0.10
    }
  },
  "repayment": {
    "base_recovery_percentage": 10.0,
    "min_recovery_percentage": 8.0,
    "max_recovery_percentage": 20.0,
    "volatility_adjustment_threshold": 0.6,
    "volatility_adjustment_pp": 2.0,
    "decline_adjustment_threshold": -0.2,
    "decline_adjustment_pp": 2.0,
    "max_repayment_days": 30,
    "fallback_description": "Outstanding balance is due under a pre-agreed installment arrangement at the end of the repayment window."
  }
}
